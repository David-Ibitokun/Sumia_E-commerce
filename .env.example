# Django Settings
# Generate a new secret key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Option 1: Use DATABASE_URL (for production - Render, Railway, etc.)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Option 2: Use individual variables (for local development)
DB_ENGINE=django.db.backends.sqlite3
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sumia
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=disable

# Static/Media Files
# STATIC_ROOT=/path/to/staticfiles_collected

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# CSRF Trusted Origins (comma-separated)
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Logging
DJANGO_LOG_LEVEL=INFO
SHOP_LOG_LEVEL=INFO